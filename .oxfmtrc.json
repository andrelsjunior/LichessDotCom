{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "legacy/**",
    "public/**",
    "store/**",
    "pnpm-lock.yaml",
    "playwright-report/**",
    "test-results/**"
  ],
  "embeddedLanguageFormatting": "off"
}
